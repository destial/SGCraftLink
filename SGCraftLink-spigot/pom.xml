    </parent>

    <artifactId>SGCraftLink-spigot</artifactId>
    <packaging>jar</packaging>

    <name>SGCraftLink Spigot</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>true</minimizeJar>
                            <!-- <filters>
                                <filter>
                                    <artifact>xyz.destiall:SGCraftLink-common</artifact>
                                    <includes>
                                        <include>xyz.destiall.sgcraftlink.SGCraftLinkCommon</include>
                                    </includes>
                                </filter>
                            </filters> -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

